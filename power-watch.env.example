# /etc/power-watch.env — keep it mode 600 (it holds the bot token).
# systemd reads this file: comments only on their own lines (a "# ..." after a value becomes
# part of the value), and no quotes needed around values with spaces.

# Required: a Xiaomi (miIO) Wi-Fi device plugged into mains power, NOT into the UPS.
# Find it with: power-watch --scan 192.168.0.0/24
# Reserve its address in the router's DHCP settings so it never changes.
POWER_WATCH_DEVICE_IP=192.168.0.150

# Telegram: a bot from @BotFather, added to the channel as an admin that can post.
# Chat id: @channelname for a public channel, or the numeric -100… id for a private one.
# Leave empty to only log to the journal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Message language: en or uk.
POWER_WATCH_LANG=en

# Optional — uncomment to change.
# Times in messages (IANA zone); default: the system's local time.
#POWER_WATCH_TZ=Europe/Kyiv
# Prefix for every message, e.g. a place name.
#POWER_WATCH_LABEL=Home
# The router; default: the default route's gateway.
#POWER_WATCH_GATEWAY=192.168.0.1
# TCP port probed on the router. Any port works if the router answers it, even with a refusal;
# check with: nc -vz 192.168.0.1 53
#POWER_WATCH_GATEWAY_PORT=53
# Seconds between probes.
#POWER_WATCH_INTERVAL_S=15
# Missed probes before "off" (~1 min at 15 s).
#POWER_WATCH_OFF_AFTER=4
