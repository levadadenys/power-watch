# power-watch — mains power monitor; posts outages to Telegram. See README.md.
#
# Install, upgrade or remove with install.sh (sudo ./install.sh [--uninstall]).
[Unit]
Description=power-watch (mains power monitor)
Documentation=https://github.com/levadadenys/power-watch
# time-sync: boards without an RTC boot with a stale clock. This ordering only holds where
# systemd-time-wait-sync.service is enabled; the script also waits for timesyncd itself.
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# Needs nothing but UDP/TCP/HTTPS out and its own directories.
DynamicUser=yes
# Read by systemd as root, so it can (and should, it holds the bot token) be mode 600.
EnvironmentFile=/etc/power-watch.env
ExecStart=/usr/bin/python3 /usr/local/bin/power-watch
Restart=always
RestartSec=30
# Exit 2 = configuration error (missing or bad setting, see the journal): stop instead of looping.
RestartPreventExitStatus=2
# /run/power-watch/state: the live state, rewritten every probe (tmpfs, no disk writes).
RuntimeDirectory=power-watch
RuntimeDirectoryMode=0755
# Not RuntimeDirectoryPreserve=: with DynamicUser that moves it under /run/private (root-only),
# so readers could no longer reach it. It is gone only between a stop and the next probe.
# /var/lib/power-watch/state.json: written on transitions only, so a restart neither repeats
# nor loses an outage.
StateDirectory=power-watch
CPUWeight=20
Nice=10

[Install]
WantedBy=multi-user.target
